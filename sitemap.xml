---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
  </url>

  <url>
    <loc>{{ '/notes/' | absolute_url }}</loc>
  </url>

  {% assign sorted_notes = site.notes | sort: "date" | reverse %}
  {% for note in sorted_notes %}
  <url>
    <loc>{{ note.url | absolute_url }}</loc>
    <lastmod>{{ note.last_modified_at | default: note.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {% endfor %}

  {% assign sorted_memories = site.memories | sort: "date" | reverse %}
  {% for memory in sorted_memories %}
  <url>
    <loc>{{ memory.url | absolute_url }}</loc>
    <lastmod>{{ memory.last_modified_at | default: memory.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {% endfor %}
</urlset>
